{
  "name": "quadeck",
  "version": "0.4.16",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun scripts/start.ts",
    "compile": "bun run scripts/compile.ts",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck": "bun run i18n && tsc --noEmit",
    "test": "bun run i18n && bun --bun vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && bun scripts/gen-migrations.ts",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "2.2.4"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
