// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what Quadeck builds on, plus the "Dependency Dashboard" issue listing what is open. Their own
// pull requests: Bun, which is compiled into every release binary (bun build --compile), with its
// types, and the Alpine of the distro CI (the one musl distribution it tests).
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `npx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // bun-version in CI, the release and the screenshots
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["bun-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "oven-sh/bun",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^bun-v(?<version>.+)$",
    },
    {
      // The Alpine (musl) row of the distros job in ci.yml
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: ["image: 'alpine:(?<currentValue>\\d+\\.\\d+)'"],
      depNameTemplate: "docker.io/library/alpine",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // Bun: CI, release and screenshots, and the types, in one PR
      matchPackageNames: ["oven-sh/bun", "@types/bun"],
      enabled: true,
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The release binaries carry this Bun as their runtime (`scripts/compile.ts`, targets `bun-linux-x64-baseline`, `-arm64`, `-x64-musl`, `-arm64-musl`), so a Bun update reaches every installation with the next release. Before merging: read the release notes for `bun build --compile`, `Bun.serve`, `bun:sqlite`, `Bun.spawn` and the musl builds; the distros job of this PR starts the new binary on every distribution of the matrix. On real hardware, check `quadeck doctor` and the self-update (`src/server/update.ts`) once with a binary from this branch.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["docker.io/library/alpine"],
      sourceUrl: "https://gitlab.alpinelinux.org/alpine/aports",
      prBodyNotes: [
        "Only the distros job uses it (the musl binary with `libstdc++ libgcc`). If it fails, the musl binary does not start on current Alpine: that is a finding for the README's \"Runs on\" table, not a reason to stay on the old image.",
      ],
      groupName: "alpine",
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
  ],
}
