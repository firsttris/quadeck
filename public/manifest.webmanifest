{
  "name": "Quadeck",
  "short_name": "Quadeck",
  "description": "Web UI for Podman Quadlets and systemd on a home server",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0f14",
